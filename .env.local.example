# ConectaTEA · variáveis de ambiente
#
# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (Project Settings → API).
#
# Sem essas variáveis o app inicia automaticamente em MODO DEMONSTRAÇÃO,
# com dados de exemplo salvos no localStorage do navegador.

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
